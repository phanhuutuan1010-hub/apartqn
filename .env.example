# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables
# (Production + Preview). Changes apply only after a redeploy.

# Public site origin, no trailing slash — used for canonical/hreflang, sitemap, OG
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Leads by email (Resend). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL="ApartQN <leads@your-domain.example>"

# Leads by Telegram bot (create with @BotFather; chat id of the owner/group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Consign photos → Vercel Blob (Vercel → Storage → Blob → connect to project creates this)
BLOB_READ_WRITE_TOKEN=

# Phase 2 (admin panel) — not used yet
# ADMIN_PASSWORD=
# GITHUB_TOKEN=
# GITHUB_REPO=
# GITHUB_BRANCH=main
