# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables
# (Production + Preview). Changes apply only after a redeploy.

# Public site origin, no trailing slash — used for canonical/hreflang, sitemap, OG
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase — NEW API keys (Project Settings → API Keys). Legacy anon/service_role keys are deprecated (end of 2026).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# sb_publishable_… → acts as the anon role; safe in the browser (RLS applies)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… → SERVER ONLY, bypasses RLS. Never prefix with NEXT_PUBLIC_, never send to the browser.
SUPABASE_SECRET_KEY=
# Postgres for migrations / seed only (Connect → Session pooler, port 5432). Not needed on Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Leads by email (Resend). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL="ApartQN <leads@your-domain.example>"

# Leads by Telegram bot (create with @BotFather; chat id of the owner/group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Consign photos → Vercel Blob (Vercel → Storage → Blob → connect to project creates this)
BLOB_READ_WRITE_TOKEN=

# Phase 2 (admin panel) — not used yet
# ADMIN_PASSWORD=
# GITHUB_TOKEN=
# GITHUB_REPO=
# GITHUB_BRANCH=main
