# Copy to .env.local for local dev; set the same keys in Vercel → Settings → Environment Variables
# (Production + Preview). Changes apply only after a redeploy. Never commit real values.

# Public site origin, no trailing slash — canonical/hreflang, sitemap, OG, links in staff emails/Telegram
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Supabase — NEW API keys (Project Settings → API Keys). Legacy anon/service_role keys are deprecated (end of 2026).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# sb_publishable_… → acts as the anon role; safe in the browser (RLS applies)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_… → SERVER ONLY, bypasses RLS (website forms, invites, cron). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Postgres for migrations / seed / scripts only (Connect → Session pooler, port 5432). Not needed on Vercel.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Email (Resend) — lead notifications + staff invites / password resets. FROM must be on a domain verified in Resend.
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL="ApartQN <leads@your-domain.example>"

# Telegram bot (@BotFather). Staff put their own chat id in /admin/tai-khoan; the bot messages them directly.
TELEGRAM_BOT_TOKEN=
# bot username without @ (shown in the account page instructions)
TELEGRAM_BOT_USERNAME=
# optional fallback group/chat when no assignee/admin has a chat id
TELEGRAM_CHAT_ID=

# Vercel Cron (vercel.json → /api/cron/daily). Any long random string; Vercel sends it as a Bearer token.
CRON_SECRET=
